# VAOS-Kernel Environment Variables

# gRPC listen address (default: 0.0.0.0:50051)
VAOS_KERNEL_GRPC_ADDR=0.0.0.0:50051

# HTTP/WebSocket listen address (default: 0.0.0.0:8080)
VAOS_KERNEL_WS_ADDR=0.0.0.0:8080

# Attestation mode: sync | async | db-sync | db-async (default: sync)
VAOS_KERNEL_MODE=sync

# Set false to suppress structured audit entries on stdout (useful for benchmarks).
# VAOS_AUDIT_STDOUT=false

# JWT signing key (required for production; if unset, a random key is generated per-run)
# VAOS_JWT_SECRET=your-secret-key-here-min-32-bytes

# API secret for HTTP endpoint auth (if unset, endpoints are unauthenticated — dev mode)
# VAOS_API_SECRET=your-api-secret-here

# Agentic JWT P0 compatibility endpoints. The registry path, three scoped OAuth
# clients, and all values below are required when enabled. SIGNING_KEY is either
# a base64url 64-byte Ed25519 private key or seed:<base64url-32-byte-seed>.
# The seed: prefix prevents a raw public key from being mistaken for a seed.
# Agent proof public keys are registered separately.
# VAOS_AGENTIC_JWT_ENABLED=true
# VAOS_AGENTIC_JWT_APP_ID=your-app-id
# VAOS_AGENTIC_JWT_ISSUER=https://authority.example.com
# VAOS_AGENTIC_JWT_SIGNING_KEY=base64url-ed25519-seed-or-private-key
# VAOS_AGENTIC_JWT_TTL_SECONDS=300
# Owner-only JSON registry file. Existing registrations and workflows are
# restored on restart; mutations are atomically replaced and fsynced.
# VAOS_AGENTIC_JWT_REGISTRY_PATH=/var/lib/vaos/agentic-registry.json
# Three least-privilege OAuth clients replace shared bearer secrets.
# VAOS_AGENTIC_JWT_REGISTRAR_CLIENT_ID=registrar
# VAOS_AGENTIC_JWT_REGISTRAR_CLIENT_SECRET=change-this-registrar-secret
# VAOS_AGENTIC_JWT_WORKFLOW_CLIENT_ID=workflow-admin
# VAOS_AGENTIC_JWT_WORKFLOW_CLIENT_SECRET=change-this-workflow-secret
# VAOS_AGENTIC_JWT_TOKEN_CLIENT_ID=token-issuer
# VAOS_AGENTIC_JWT_TOKEN_CLIENT_SECRET=change-this-token-secret

# Optional comma-separated WebSocket origins. Defaults to same-host browser origins.
# VAOS_WS_ALLOWED_ORIGINS=https://console.example.com

# PostgreSQL connection (used by DefaultConfig; falls back to localhost defaults)
# VAOS_DB_HOST=localhost
# VAOS_DB_PORT=5432
# VAOS_DB_USER=postgres
# VAOS_DB_PASSWORD=vaos
# VAOS_DB_NAME=vaos

# PostgreSQL DSN (required for db-sync and db-async modes)
# VAOS_DB_DSN=host=localhost user=postgres dbname=vaos_kernel sslmode=disable

# AMQP URL for telemetry (optional; defaults to guest:guest@localhost — NOT for production)
# AMQP_URL=amqp://guest:guest@localhost:5672

# Docker Compose RabbitMQ settings
# VAOS_RABBITMQ_USER=vaos
# VAOS_RABBITMQ_PASSWORD=vaos
# VAOS_AMQP_PORT=5672
